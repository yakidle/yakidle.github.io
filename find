<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>回忆录 · 时光入口</title>
    <style>
        /* 全局重置与基础字体 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            min-height: 100vh;
            background: linear-gradient(145deg, #f9f3e8 0%, #ffe9d6 100%);
            /* 柔和的暖色渐变，像旧纸张 */
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            position: relative;
            overflow-x: hidden;
        }

        /* 装饰性元素：飘浮的圆点，增加梦幻感 */
        body::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background-image: radial-gradient(rgba(200, 160, 120, 0.15) 1px, transparent 1px);
            background-size: 40px 40px;
            pointer-events: none;
            z-index: 1;
        }

        /* 主卡片 */
        .memory-card {
            max-width: 800px;
            width: 100%;
            background: rgba(255, 245, 235, 0.75);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 48px;
            padding: 3rem 2.5rem;
            box-shadow: 
                0 25px 50px -12px rgba(0, 0, 0, 0.25),
                inset 0 1px 2px rgba(255, 255, 255, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.4);
            text-align: center;
            position: relative;
            z-index: 10;
            animation: fadeInUp 1.2s cubic-bezier(0.23, 1, 0.32, 1) forwards;
            transform-origin: center;
        }

        /* 标题区域 */
        .title {
            font-size: clamp(2.5rem, 8vw, 5rem);
            font-weight: 500;
            color: #4a3b2c;
            letter-spacing: 2px;
            margin-bottom: 0.2rem;
            text-shadow: 0 2px 5px rgba(255, 235, 200, 0.8);
            line-height: 1.1;
        }

        .subtitle {
            font-size: clamp(1.1rem, 4vw, 1.6rem);
            color: #7d6b58;
            font-weight: 300;
            font-style: italic;
            margin-bottom: 2.8rem;
            border-bottom: 1px dashed rgba(160, 130, 100, 0.3);
            padding-bottom: 1.2rem;
            display: inline-block;
        }

        /* 装饰线 */
        .divider {
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, transparent, #c9ad8e, transparent);
            margin: 2rem auto 2.5rem;
        }

        /* 一段感性的文案 */
        .quote {
            font-size: 1.3rem;
            color: #5f4e3c;
            line-height: 1.8;
            margin-bottom: 3rem;
            font-weight: 300;
            max-width: 550px;
            margin-left: auto;
            margin-right: auto;
            background: rgba(245, 225, 205, 0.3);
            padding: 1.5rem 2rem;
            border-radius: 60px;
            backdrop-filter: blur(4px);
            box-shadow: 0 4px 10px rgba(0,0,0,0.03);
        }

        /* 按钮样式 */
        .enter-btn {
            display: inline-block;
            background: #b28b6f;
            color: #fffcf7;
            font-size: 1.6rem;
            font-weight: 500;
            padding: 1.2rem 3.8rem;
            border-radius: 50px;
            text-decoration: none;
            letter-spacing: 2px;
            border: none;
            box-shadow: 
                0 8px 20px rgba(140, 90, 50, 0.3),
                0 4px 8px rgba(0,0,0,0.1),
                inset 0 2px 4px rgba(255, 255, 255, 0.5);
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255, 245, 215, 0.6);
        }

        .enter-btn:hover {
            background: #c9a485;
            transform: translateY(-4px) scale(1.02);
            box-shadow: 
                0 15px 30px rgba(130, 80, 40, 0.4),
                0 6px 12px rgba(0,0,0,0.15),
                inset 0 2px 4px #ffe7cf;
        }

        .enter-btn:active {
            transform: translateY(2px) scale(0.98);
            box-shadow: 0 4px 12px rgba(90, 50, 20, 0.3);
        }

        /* 按钮内小箭头动画 */
        .enter-btn span {
            display: inline-block;
            transition: transform 0.2s ease;
            margin-left: 8px;
        }

        .enter-btn:hover span {
            transform: translateX(8px);
        }

        /* 底部轻柔的装饰 */
        .footer-note {
            margin-top: 3rem;
            font-size: 0.9rem;
            color: #ab9b8b;
            letter-spacing: 1px;
            opacity: 0.7;
        }

        /* 动效：卡片淡入上浮 */
        @keyframes fadeInUp {
            0% {
                opacity: 0;
                transform: translateY(30px) scale(0.98);
            }
            100% {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* 响应式微调 */
        @media (max-width: 500px) {
            .memory-card {
                padding: 2rem 1.5rem;
                border-radius: 32px;
            }
            .title {
                font-size: 3rem;
            }
            .enter-btn {
                font-size: 1.4rem;
                padding: 1rem 2.5rem;
            }
            .quote {
                font-size: 1.1rem;
                padding: 1rem 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="memory-card">
        <h1 class="title">时光漫记</h1>
        <div class="subtitle">✦ 珍藏的瞬间 ✦</div>

        <div class="quote">
            “每一段记忆，都是时光深处<br>一封未曾拆开的信。”
        </div>

        <!-- 按钮：进入回忆 -->
        <a href="#" class="enter-btn" id="enterMemoryBtn">
            进入回忆 <span>→</span>
        </a>

        <div class="footer-note">—— 轻轻推开，往事如风 ——</div>
    </div>

    <!-- 简单的JavaScript: 点击按钮时的控制（可自定义跳转） -->
    <script>
        (function() {
            const btn = document.getElementById('enterMemoryBtn');
            btn.addEventListener('click', function(e) {
                e.preventDefault();  // 阻止#的默认跳转，方便演示
                // 在这里你可以定义点击按钮后的行为，例如跳转到另一个页面：
                // window.location.href = 'memories.html'; 
                // 或者弹出提示（暂时）
                alert('即将打开回忆之门……（请修改链接为你真正的回忆页面）');
                // 如果你想直接跳转，取消下面一行的注释，并修改目标URL
                // window.location.href = 'memories.html';
            });
        })();
    </script>
</body>
</html>
